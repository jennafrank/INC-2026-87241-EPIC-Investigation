// ============================================================
// QUERY: Legacy Authentication Bypass Detection
// Incident: INC-2026-87241
// Table: SigninLogs
// Purpose: Detect single-factor sign-ins via legacy OAuth clients
//          that bypass Conditional Access MFA enforcement.
//          This is the technique used by the attacker to gain
//          initial access as m.smith@lognpacific.org.
// Platform: Microsoft Sentinel
// ============================================================

SigninLogs
| where AuthenticationRequirement == "singleFactorAuthentication"
| where IPAddress !in ("LIST_OF_TRUSTED_CORPORATE_IPS")   // Replace with actual trusted IP list
| where UserPrincipalName contains "@lognpacific.org"
| where AppDisplayName in ("One Outlook Web", "Other Legacy Clients")
| summarize SigninCount = count() by UserPrincipalName, IPAddress, AppDisplayName
| where SigninCount > 5

// ============================================================
// INCIDENT CONTEXT:
//   - Attacker IP:        103.69.224.136 (Amsterdam, NL)
//   - Breach Client:      One Outlook Web (legacy OAuth)
//   - Breach Timestamp:   2026-06-10 22:13:10 UTC
//   - Auth Requirement:   singleFactorAuthentication (MFA NOT satisfied)
//   - Session Reuse:      583+ subsequent sign-ins from same token
//
// WHY LEGACY AUTH BYPASSES MFA:
//   Modern Conditional Access policies enforce MFA for cloud sign-ins.
//   However, legacy OAuth clients (like One Outlook Web) are explicitly
//   exempted for backward compatibility with older applications.
//   These clients cannot handle MFA challenges, so they are exempt —
//   creating an unmonitored, MFA-free authentication path.
//
// TUNING:
//   - Replace "LIST_OF_TRUSTED_CORPORATE_IPS" with actual trusted IP ranges
//   - Adjust SigninCount threshold based on environment baseline
//   - Consider alerting on ANY singleFactorAuthentication from external IPs
//   - Add AppDisplayName filter for all known legacy clients in your org
// ============================================================
